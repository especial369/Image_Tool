<view class="page">
  <view class="hero">
    <view class="hero-title">图片压缩</view>
    <view class="hero-sub">图片不离开手机 · 不上传服务器 · 无水印</view>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="title" wx:for-item="g">
    <view class="group-title">{{g.title}}</view>
    <view class="grid-row" wx:for="{{g.rows}}" wx:for-item="row" wx:key="index">
      <view
        class="card"
        hover-class="card-hover"
        wx:for="{{row}}"
        wx:key="key"
        wx:for-item="cap"
        bindtap="onCap"
        data-key="{{cap.key}}"
      >
        <view class="card-icon icon-{{cap.tint}}">{{cap.icon}}</view>
        <view class="card-name">{{cap.name}}</view>
        <view class="card-desc">{{cap.desc}}</view>
      </view>
    </view>
  </view>

  <button class="btn-ghost chat-btn" hover-class="btn-hover" bindtap="onPickChat">从聊天记录选择图片文件</button>

  <view class="footer">
    <text class="about-link" bindtap="onAbout">关于 / 隐私政策</text>
  </view>
</view>
