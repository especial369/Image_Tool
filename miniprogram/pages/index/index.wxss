.hero {
  padding: 56rpx 8rpx 44rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #86909c;
}

/* 显式两行布局：flex:1 等分 + 兄弟 margin 做间距（不用 gap/calc，兼容所有机型内核） */
.grid-row {
  display: flex;
  margin-bottom: 24rpx;
}

.card {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.04);
}

.card + .card {
  margin-left: 24rpx;
}

.card-hover {
  transform: scale(0.98);
  opacity: 0.85;
}

.card-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.icon-green {
  background: rgba(7, 193, 96, 0.12);
}

.icon-blue {
  background: rgba(22, 93, 255, 0.12);
}

.icon-orange {
  background: rgba(255, 125, 0, 0.14);
}

.icon-purple {
  background: rgba(114, 46, 209, 0.12);
}

.card-name {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.card-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #86909c;
}

.chat-btn {
  margin-top: 44rpx;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
}

.about-link {
  font-size: 26rpx;
  color: #86909c;
}
