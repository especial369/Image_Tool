.summary-main {
  font-size: 36rpx;
  font-weight: 700;
}

.summary-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ff7d00;
}

.item {
  display: flex;
  align-items: flex-start;
}

.item-thumb {
  width: 148rpx;
  height: 148rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.item-line {
  display: flex;
  align-items: center;
}

.item-size {
  font-size: 28rpx;
  font-weight: 600;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

.badge-good {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.badge-bad {
  color: #ff7d00;
  background: rgba(255, 125, 0, 0.1);
}

.badge-neutral {
  color: #86909c;
  background: #f2f3f5;
}

.item-dim {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #86909c;
}

.item-actions {
  margin-top: 18rpx;
  display: flex;
}

.act {
  font-size: 26rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
}

.act-hover {
  opacity: 0.7;
}

.failed-item {
  font-size: 24rpx;
  color: #f53f3f;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.retry-btn {
  margin-top: 16rpx;
  font-size: 26rpx;
}

/* 底部操作区：主按钮全宽，次要按钮一行三个并排 */
.quick-row {
  display: flex;
  align-items: center;
}

.quick-row-gap {
  margin-top: 24rpx;
}

.quick-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

.quick-btn + .quick-btn {
  margin-left: 20rpx;
}

/* 分享多选弹层（自建半屏面板；微信无一次发多图 API） */
.share-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.share-panel {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: share-up 0.25s ease-out;
}

@keyframes share-up {
  from {
    transform: translateY(30%);
    opacity: 0.6;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.share-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.share-title {
  font-size: 32rpx;
  font-weight: 600;
}

.share-close {
  font-size: 44rpx;
  line-height: 1;
  color: #86909c;
  padding: 0 8rpx;
}

.share-grid {
  display: flex;
  flex-wrap: wrap;
  max-height: 40vh;
  overflow-y: auto;
}

.share-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 160rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f3f5;
}

.share-cell:nth-child(3n) {
  margin-right: 0;
}

.share-thumb {
  width: 100%;
  height: 100%;
}

.share-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.25);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.share-check.checked {
  background: #07c160;
  border-color: #07c160;
}

.share-send {
  margin-top: 28rpx;
}

.share-card {
  margin-top: 20rpx;
}

.share-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #86909c;
  text-align: center;
}

.ad-block {
  margin-bottom: 24rpx;
  min-height: 20rpx;
}
