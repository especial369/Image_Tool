.sec-title {
  margin-bottom: 16rpx;
}

.thumbs {
  white-space: nowrap;
}

.thumb-cell {
  display: inline-block;
  width: 128rpx;
  margin-right: 20rpx;
}

.thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
}

.thumb-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #86909c;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pick-row {
  display: flex;
  margin-top: 20rpx;
}

.pick-btn {
  flex: 1;
  font-size: 28rpx;
}

.pick-btn + .pick-btn {
  margin-left: 20rpx;
}

.seg {
  display: flex;
  background: #eef0f3;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #4e5969;
  border-radius: 12rpx;
}

.seg-on {
  background: #ffffff;
  color: #07c160;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.08);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin: 0 0 8rpx;
}

.chip {
  padding: 14rpx 30rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #4e5969;
  margin: 0 16rpx 16rpx 0;
  border: 2rpx solid transparent;
}

.chip-on {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  font-weight: 600;
  border-color: rgba(7, 193, 96, 0.45);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 4rpx;
}

.kb-input {
  width: 240rpx;
  border: 2rpx solid #e5e6eb;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  text-align: right;
}

.hint {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 16rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 16rpx;
}

.err {
  margin-top: 24rpx;
  color: #f53f3f;
  font-size: 26rpx;
}

.engine-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 8px;
  height: 8px;
}
