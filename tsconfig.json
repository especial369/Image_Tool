{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["miniprogram-api-typings"],
    "noEmit": true
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules"]
}
